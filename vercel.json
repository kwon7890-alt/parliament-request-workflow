{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "cleanUrls": true,
  "redirects": [
    { "source": "/web", "destination": "/", "permanent": false },
    { "source": "/web/index", "destination": "/", "permanent": false },
    { "source": "/web/assign", "destination": "/", "permanent": false },
    { "source": "/web/dept", "destination": "/", "permanent": false },
    { "source": "/web/collect", "destination": "/", "permanent": false },
    { "source": "/web/chat", "destination": "/", "permanent": false },
    { "source": "/web/index.html", "destination": "/", "permanent": false },
    { "source": "/web/assign.html", "destination": "/", "permanent": false },
    { "source": "/web/dept.html", "destination": "/", "permanent": false },
    { "source": "/web/collect.html", "destination": "/", "permanent": false },
    { "source": "/web/chat.html", "destination": "/", "permanent": false }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" }
      ]
    }
  ]
}
